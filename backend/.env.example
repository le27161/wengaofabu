# 后端环境配置模板：复制为 .env 后按需修改
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env

# ---- 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=wengaofabu

# ---- JWT 安全配置（生产环境务必修改为随机长字符串）----
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
# 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 文件上传 ----
# 上传文件保存目录（相对 backend 目录或绝对路径）
UPLOAD_DIR=uploads
# 单文件最大字节数，默认 20MB
MAX_UPLOAD_SIZE=20971520
# 静态资源完整 URL 前缀，生产环境改为实际域名
BASE_URL=http://localhost:8000

# ---- Dify 工作流（预留）----
# Dify 应用 API 地址：云端 https://api.dify.ai/v1，自建为 http(s)://你的域名/v1
DIFY_API_BASE=
# Dify 应用 API Key（格式 app-xxx，在 Dify 控制台「访问 API」中获取）
DIFY_API_KEY=
# 调用超时（秒）
DIFY_TIMEOUT=30

# AI 大模型 API（OpenAI 兼容接口，如 DeepSeek / Groq / 硅基流动等）
# 用于文章 AI 全文总结、划词解释、关键词提取与标签解释
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT=60

# Tavily 新闻搜索（真实 Key 只填写在 backend/.env，不要提交）
TAVILY_API_KEY=
TAVILY_TIMEOUT=15

# 本地Embedding：相对项目根目录 backend/app/multilingual-e5-small；auto优先CUDA，不可用时回退CPU
EMBEDDING_MODEL_NAME=backend/app/multilingual-e5-small
EMBEDDING_DEVICE=auto

# Grounded事件整理LLM（真实Key只填写在backend/.env或系统环境变量）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT=90

# ---- KnowledgeHub RAG 新闻助手（独立服务）----
# RAG 服务未启动时保持 false；启动后改为 true。
RAG_ENABLED=false
RAG_BASE_URL=http://127.0.0.1:8001
RAG_TIMEOUT=60
# 前台新闻页面地址，例如 http://localhost:5173；留空则返回 /article/{id} 相对链接。
NEWS_PUBLIC_BASE_URL=
